rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Einfluss-Test ----------
    match /sessions/{pin} {
      allow get: if true;
      allow create: if pin.matches('^[0-9]{4}$')
                    && request.resource.data.keys().hasOnly(['created'])
                    && request.resource.data.created == request.time;
      allow list, update, delete: if false;

      match /results/{id} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['I', 'W', 'share', 'areas', 'at'])
                      && request.resource.data.I is number
                      && request.resource.data.I >= 0 && request.resource.data.I <= 1
                      && request.resource.data.W is number
                      && request.resource.data.W >= 0 && request.resource.data.W <= 1
                      && request.resource.data.share is number
                      && request.resource.data.share >= 0 && request.resource.data.share <= 1
                      && request.resource.data.areas is map
                      && request.resource.data.areas.size() <= 11
                      && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }

    // ---------- Frömmigkeitskompass ----------
    match /kompass/{pin} {
      allow get: if true;
      allow create: if pin.matches('^[0-9]{4}$')
                    && request.resource.data.keys().hasOnly(['created'])
                    && request.resource.data.created == request.time;
      allow list, update, delete: if false;

      // Anonyme Ergebnisse: nur Position im Kompass und Typ
      match /results/{id} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['x', 'y', 't', 'at'])
                      && request.resource.data.x is number
                      && request.resource.data.x >= -4 && request.resource.data.x <= 4
                      && request.resource.data.y is number
                      && request.resource.data.y >= -4 && request.resource.data.y <= 4
                      && request.resource.data.t in ['mys', 'esc', 'ask', 'apo']
                      && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }
  }
}
